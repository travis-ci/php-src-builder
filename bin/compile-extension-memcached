#!/bin/bash
set -o xtrace
set -o errexit
source $(dirname $0)/compile-extensions-common

function install_memcache() {
	pushd /tmp
	wget https://launchpad.net/libmemcached/1.0/1.0.18/+download/libmemcached-1.0.18.tar.gz
	tar xzf libmemcached-1.0.18.tar.gz
	pushd libmemcached-1.0.18
	CXXFLAGS="-fpermissive" ./configure --prefix=$INSTALL_DEST/$VERSION && make && make install
	popd
	popd
}

travis_time_start

if [ -d "/usr/include/libmemcached" ]; then
  echo "Using system libmemcached library"
  LIBMEMCACHED_DIR="/usr"
else
  echo "Compiling custom libmemcached version"
  install_memcache
  LIBMEMCACHED_DIR="$INSTALL_DEST/$VERSION"
fi

if [[ $VERSION =~ ^7 || $VERSION =~ ^8 || $VERSION =~ ^master$ ]]; then
    pecl download memcached-3.2.0
    DIR=$(pwd)
    ARCHIVE=$(ls $DIR/memcached-3.2.0.tar.gz $DIR/memcached-3.2.0.tgz 2>/dev/null | head -n1)
    if [[ -n "$ARCHIVE" ]]; then
        tar xf "$ARCHIVE"
        pushd memcached*/
        make clean || true
    else
        echo "Missing archive"
        exit 1
    fi
else
    pecl download memcached-2.2.0
    DIR=$(pwd)
    ARCHIVE=$(ls $DIR/memcached-2.2.0.tar.gz $DIR/memcached-2.2.0.tgz 2>/dev/null | head -n1)
    if [[ -n "$ARCHIVE" ]]; then
        tar xf "$ARCHIVE"
        pushd memcached*/
        make clean || true
    else
        echo "Missing archive"
        exit 1
    fi
fi


"$PHPIZE"
CXXFLAGS="-fpermissive" ./configure --with-php-config="$PHP_CONFIG" --with-libmemcached-dir=$LIBMEMCACHED_DIR && make && make install
popd

if ! grep -q "extension=memcached.so" $INSTALL_DEST/$VERSION/etc/php.ini; then
  echo "extension=memcached.so" >> $INSTALL_DEST/$VERSION/etc/php.ini
fi

travis_time_finish
