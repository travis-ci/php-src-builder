#!/bin/bash
set -o xtrace
set -o errexit
source $(dirname $0)/compile-extensions-common

travis_time_start

dist=$(lsb_release -cs)
if [[ "${dist}" = "focal" || "${dist}" = "jammy" || "${dist}" = "noble" ]]; then
    if [[ $VERSION =~ ^master$ || $VERSION =~ snapshot$ ]]; then
        git clone https://github.com/mongodb/mongo-php-driver.git
        pushd mongo-php-driver
        git submodule update --init
        "$PHPIZE"
        ./configure --with-php-config="$PHP_CONFIG"
        make all
        make install
        popd
    else
        mongodb_package=mongodb
        case "$VERSION" in
            7.4|7.4.*|8.0|8.0.*)
                # MongoDB 1.21 and later require PHP 8.1 or newer.
                mongodb_package=mongodb-1.20.1
                ;;
        esac
        pecl channel-update pecl.php.net
        yes '' | pecl install "$mongodb_package"
    fi
else
    echo "MongoDB missing for PHP older than 7.4, tip set php at least 7.4 after installing php-dev"
fi

travis_time_finish

true
